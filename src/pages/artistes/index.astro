---
import Layout from "../../layouts/Layout.astro";
import pb from "../../lib/pocketbase.mjs";

// On récupère les représentations triées par date, avec les artistes et scènes
var representations = await pb.collection("representation").getFullList({
  sort: "date_heure",
  expand: "artiste,scene",
});

// Extraire les jours uniques pour les filtres
// On utilise les 10 premiers caractères de la date (ex: "2026-10-28")
var jours = [];
for (var i = 0; i < representations.length; i++) {
  var jour = representations[i].date_heure.substring(0, 10);
  if (jours.indexOf(jour) === -1) {
    jours.push(jour);
  }
}

// Extraire les artistes sans doublons, avec leurs infos de représentation
var artistes = [];
var idDejaVus = [];

for (var i = 0; i < representations.length; i++) {
  var rep = representations[i];
  var artiste = rep.expand.artiste;

  if (idDejaVus.indexOf(artiste.id) === -1) {
    idDejaVus.push(artiste.id);

    artistes.push({
      id: artiste.id,
      nom: artiste.nom,
      genre_musical: artiste.genre_musical,
      photo_principale: artiste.photo_principale,
      collectionId: artiste.collectionId,
      date_heure: rep.date_heure,
      scene_nom: rep.expand.scene.nom,
      jour: rep.date_heure.substring(0, 10),
    });
  }
}
---

<Layout title="Artistes">

  <!-- Titre -->
  <h1 class="text-4xl font-black text-green-700 mb-6">Artistes</h1>

  <!-- Filtres par jour -->
  <div class="flex flex-wrap gap-3 mb-4">
    <button class="filtre-jour bg-yellow-500 text-green-900 font-semibold px-5 py-2 rounded-full text-sm active" data-jour="tous">
      Tous
    </button>
    {jours.map(function (jour, index) {
      return (
        <button class="filtre-jour bg-green-800 hover:bg-yellow-400 font-semibold px-5 py-2 rounded-full text-sm transition-colors" data-jour={jour}>
          {jour}
        </button>
      );
    })}
  </div>

  <!-- Jour sélectionné -->
  <h2 id="jour-titre" class="text-2xl font-bold text-red-700 mb-6">Tous les jours</h2>

  <!-- Barre de recherche -->
  <div class="relative max-w-md mb-8">
    <label class="block text-sm text-green-900 mb-2">Rechercher un artiste</label>
    <div class="flex">
      <input
        id="recherche"
        type="text"
        placeholder="Nom de l'artiste ou de la scène"
        class="w-full px-4 py-3 rounded-l-full text-gray-900 outline-none"
      />
      <button class="bg-green-600 px-4 rounded-r-full text-green-700 font-bold text-xl">🔍</button>
    </div>
  </div>

  <div id="grille-artistes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {artistes.map(function (artiste) {
      // URL de la photo depuis PocketBase
      var photoUrl = "";
      if (artiste.photo_principale) {
        photoUrl = "http://127.0.0.1:8090/api/files/" + artiste.collectionId + "/" + artiste.id + "/" + artiste.photo_principale;
      }

      // Formater la date
      var date = new Date(artiste.date_heure);
      var dateTexte = date.toLocaleDateString("fr-FR", {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
      var heureTexte = date.toLocaleTimeString("fr-FR", {
        hour: "2-digit",
        minute: "2-digit",
      });

      return (
        <a
          href={"/artistes/" + artiste.id}
          class="artiste-card group relative block overflow-hidden aspect-[4/3]"
          data-jour={artiste.jour}
          data-nom={artiste.nom.toLowerCase()}
          data-scene={artiste.scene_nom.toLowerCase()}
        >
          {/* Photo en fond */}
          {photoUrl ? (
            <img src={photoUrl} alt={artiste.nom}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          ) : (
            <div class="absolute inset-0 bg-green-800"></div>
          )}

          {/* Dégradé sombre en bas */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>

          {/* Texte en overlay */}
          <div class="absolute bottom-0 left-0 p-5">
            <h3 class="text-2xl font-black">{artiste.nom}</h3>
            <p class="text-yellow-400 font-semibold">{dateTexte} – {heureTexte}</p>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Scripts : filtrage par jour + recherche -->
  <script is:inline>
    // Filtrage par jour
    var boutonsFiltres = document.querySelectorAll(".filtre-jour");
    var cards = document.querySelectorAll(".artiste-card");
    var titrJour = document.getElementById("jour-titre");

    for (var i = 0; i < boutonsFiltres.length; i++) {
      boutonsFiltres[i].addEventListener("click", function () {
        // Mise à jour du style actif
        for (var j = 0; j < boutonsFiltres.length; j++) {
          boutonsFiltres[j].classList.remove("bg-white", "text-green-900");
          boutonsFiltres[j].classList.add("bg-green/20");
        }
        this.classList.add("bg-white", "text-green-900");
        this.classList.remove("bg-green/20");

        var jour = this.dataset.jour;

        if (jour === "tous") {
          titrJour.textContent = "Tous les jours";
        } else {
          titrJour.textContent = jour;
        }

        for (var k = 0; k < cards.length; k++) {
          if (jour === "tous" || cards[k].dataset.jour === jour) {
            cards[k].style.display = "";
          } else {
            cards[k].style.display = "none";
          }
        }
      });
    }

    // Recherche
    var champRecherche = document.getElementById("recherche");
    champRecherche.addEventListener("input", function () {
      var texte = this.value.toLowerCase();

      for (var i = 0; i < cards.length; i++) {
        var nom = cards[i].dataset.nom;
        var scene = cards[i].dataset.scene;
        if (nom.indexOf(texte) !== -1 || scene.indexOf(texte) !== -1) {
          cards[i].style.display = "";
        } else {
          cards[i].style.display = "none";
        }
      }
    });
  </script>

</Layout>
