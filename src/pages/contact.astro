---

import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <h1 class="text-4xl font-black text-green-700 mb-8">Contact</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <!-- Formulaire -->
    <section class="bg-green-800 rounded-2xl p-8">
      <h2 class="text-2xl font-bold mb-6 text-yellow-400">Écrivez-nous</h2>
      <form name="contact" method="POST" data-netlify="true" class="space-y-4">
        <input type="hidden" name="form-name" value="contact" />
        <div>
          <label for="nom" class="block text-sm text-green-300 mb-1">Nom</label>
          <input type="text" id="nom" name="nom" required
            class="w-full px-4 py-3 rounded-full text-gray-900 outline-none" />
        </div>
        <div>
          <label for="email" class="block text-sm text-green-300 mb-1">Email</label>
          <input type="email" id="email" name="email" required
            class="w-full px-4 py-3 rounded-full text-gray-900 outline-none" />
        </div>
        <div>
          <label for="sujet" class="block text-sm text-green-300 mb-1">Sujet</label>
          <input type="text" id="sujet" name="sujet" required
            class="w-full px-4 py-3 rounded-full text-gray-900 outline-none" />
        </div>
        <div>
          <label for="message" class="block text-sm text-green-300 mb-1">Message</label>
          <textarea id="message" name="message" rows="5" required
            class="w-full px-4 py-3 rounded-2xl text-gray-900 outline-none"></textarea>
        </div>
        <button type="submit" class="bg-yellow-400 text-green-900 font-bold px-8 py-3 rounded-full hover:bg-yellow-300 transition-colors">
          Envoyer
        </button>
      </form>
    </section>

    <!-- Coordonnées -->
    <section>
      <div class="bg-green-800 rounded-2xl p-8 mb-6">
        <h2 class="text-2xl font-bold mb-6 text-yellow-400">Coordonnées</h2>
        <div class="space-y-4 text-green-100">
          <p>
            <span class="font-bold text-white">Email</span><br />
            contact@echos-sonores.fr
          </p>
          <p>
            <span class="font-bold text-white">Téléphone</span><br />
            01 23 45 67 89
          </p>
          <p>
            <span class="font-bold text-white">Adresse</span><br />
            Audincourt<br />
            25300 Audincourt
          </p>
        </div>
      </div>

      <div class="bg-green-800 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-4 text-yellow-400">Réseaux sociaux</h2>
        <div class="flex gap-4">
          <a href="#" class="bg-white/20 px-5 py-2 rounded-full hover:bg-white/40 transition-colors">Facebook</a>
          <a href="#" class="bg-white/20 px-5 py-2 rounded-full hover:bg-white/40 transition-colors">Instagram</a>
          <a href="#" class="bg-white/20 px-5 py-2 rounded-full hover:bg-white/40 transition-colors">Twitter</a>
        </div>
      </div>
    </section>

  </div>
</Layout>
